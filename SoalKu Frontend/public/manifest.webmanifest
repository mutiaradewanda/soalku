{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "SoalKu - Adaptive AI Learning Platform",
  "short_name": "SoalKu",
  "description": "Platform Belajar & Latihan Soal Adaptif Berbasis AI untuk Siswa SD, Siswa SMP, dan Portal Guru.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#0284C7",
  "lang": "id",
  "dir": "ltr",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512x512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Mulai Latihan Soal",
      "short_name": "Latihan",
      "description": "Pilih mode latihan acak, berwaktu, atau fokus kelemahan",
      "url": "/latihan",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Rapor Evaluasi Belajar",
      "short_name": "Evaluasi",
      "description": "Lihat analisis titik kelemahan per materi dan catatan guru",
      "url": "/evaluasi",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Portal Guru & Review Soal",
      "short_name": "Guru",
      "description": "Kurasi bank soal AI dan pantau progres siswa binaan",
      "url": "/dashboard/guru",
      "icons": [{ "src": "/icons/icon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "prefer_related_applications": false
}
